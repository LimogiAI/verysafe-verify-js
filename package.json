{
  "name": "@verysafe/verify",
  "version": "0.1.0",
  "description": "The browser library for VerySafe's EU wallet verifier: the browser prompt first, then a link on a phone, then a QR code. A browser half for the page and a server half for Node.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "exports": {
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./iife": "./dist/verysafe-verify.iife.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format --write",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/bundle.mjs",
    "example": "node examples/server.mjs",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LimogiAI/verysafe-verify-js.git"
  },
  "homepage": "https://github.com/LimogiAI/verysafe-verify-js#readme",
  "bugs": {
    "url": "https://github.com/LimogiAI/verysafe-verify-js/issues"
  },
  "keywords": [
    "eudi",
    "eudi-wallet",
    "openid4vp",
    "digital-credentials-api",
    "verifier",
    "verysafe"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.4",
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
